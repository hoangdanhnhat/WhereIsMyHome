# ============================================================
# WhereIsMyHome — IP Tracker Configuration
# ============================================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env

# --- General ------------------------------------------------
CHECK_INTERVAL_SECONDS=300
HISTORY_LIMIT=20

# --- Discord ------------------------------------------------
DISCORD_ENABLED=false
DISCORD_BOT_TOKEN=
DISCORD_USER_ID=
# Optional: post IP changes to a private channel as well
DISCORD_CHANNEL_ID=

# --- Email (SMTP) -------------------------------------------
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=

# --- Telegram -----------------------------------------------
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
